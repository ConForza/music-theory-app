{
  "name": "@mtp/api",
  "private": true,
  "version": "0.1.0",
  "description": "Music Theory Path backend: accounts, sessions, curriculum-derived path state and lesson progress (SQLite).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --watch src/main.ts",
    "author:grade1": "tsx scripts/author-grade1.ts",
    "docs:grade1": "tsx scripts/grade1-docs.ts",
    "audit:mastery": "tsx scripts/audit-mastery.ts",
    "author:grade2": "tsx scripts/author-grade2.ts",
    "docs:grade2": "tsx scripts/grade2-docs.ts",
    "author:grade3": "tsx scripts/author-grade3.ts",
    "docs:grade3": "tsx scripts/grade3-docs.ts",
    "author:grade4": "tsx scripts/author-grade4.ts",
    "docs:grade4": "tsx scripts/grade4-docs.ts",
    "author:grade5": "tsx scripts/author-grade5.ts",
    "docs:grade5": "tsx scripts/grade5-docs.ts",
    "author:terms": "tsx scripts/author-terms.ts",
    "docs:terms": "tsx scripts/terminology-docs.ts"
  },
  "dependencies": {
    "@mtp/curriculum": "0.1.0",
    "zod": "^4.6.7",
    "@mtp/engine": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
