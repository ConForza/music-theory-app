{
  "name": "@mtp/web",
  "private": true,
  "version": "0.1.0",
  "description": "Music Theory Path student app (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/followup.mjs && node --import tsx e2e/brief03.mjs && node --import tsx e2e/brief04.mjs && node --import tsx e2e/g1.mjs && node --import tsx e2e/g2.mjs && node --import tsx e2e/g3.mjs && node --import tsx e2e/g4.mjs",
    "e2e:brief02": "node e2e/run.mjs",
    "e2e:followup": "node e2e/followup.mjs",
    "e2e:brief03": "node --import tsx e2e/brief03.mjs",
    "e2e:brief04": "node --import tsx e2e/brief04.mjs",
    "e2e:grade1": "node --import tsx e2e/g1.mjs",
    "e2e:grade2": "node --import tsx e2e/g2.mjs",
    "e2e:grade3": "node --import tsx e2e/g3.mjs",
    "e2e:grade4": "node --import tsx e2e/g4.mjs"
  },
  "devDependencies": {
    "@mtp/api": "0.1.0",
    "@mtp/curriculum": "0.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "@mtp/engine": "0.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "@vexflow-fonts/bravura": "1.0.2"
  }
}
