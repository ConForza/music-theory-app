          }
        ],
        "textAlternative": "A 4/4 bar starting with two crotchets tied together and then a minim.",
        "timeSignature": "4/4"
      },
      "caption": "Two tied crotchets in the same bar are just a minim. Write a minim instead."
    },
    {
      "kind": "notation",
      "music": {
        "presentation": "rhythm-line",
        "clef": "treble",
        "showKeySignature": false,
        "measures": [
