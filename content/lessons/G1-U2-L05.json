  "locale": "en-GB",
  "objective": {
    "statement": "Decide when a tie is needed and when one note is clearer.",
    "successCriteria": [
      "I use one note when a single note value fits.",
      "I use a tie only when no single note fits, such as across a bar-line.",
      "I can spot an unnecessary tie."
    ]
  },
  "explanation": [
    {
      "kind": "text",
      "text": "A tie makes a note longer by joining it to another note of the same pitch. But if one note can show the same length, use the one note: it is easier to read."
    },
    {
      "kind": "notation",
      "music": {
        "presentation": "rhythm-line",
        "clef": "treble",
