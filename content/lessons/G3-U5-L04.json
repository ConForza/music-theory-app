  "objective": {
    "statement": "Answer questions about a short melody, including melodies in compound time.",
    "successCriteria": [
      "I look at the clef, key signature and time signature first.",
      "I can say whether the melody is in simple or compound time and count its beats.",
      "I can name the interval from the tonic to a marked note, with its quality."
    ]
  },
  "explanation": [
    {
      "kind": "text",
      "text": "A question about a melody is easiest if you read it in the same order every time. Start with the clef, then the key signature, then the time signature, then any words or signs above the stave. Only then look at the notes."
    },
